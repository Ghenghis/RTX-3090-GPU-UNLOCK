# EditorConfig — deterministic formatting across the toolchain.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h,cpp,hpp,cu}]
indent_size = 2

[*.ps1]
# PowerShell files are authored/edited on Windows; keep CRLF to avoid noisy diffs.
end_of_line = crlf
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Preserve trailing spaces in Markdown (two-space line breaks are significant).
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
